# 🌟 ستاره داوود - اکوسیستم ربات‌های هوشمند اسرائیل
# Magen David - Israeli Smart Bot Ecosystem
# فایل نمونه متغیرهای محیطی - این فایل را کپی کرده و نام آن را به .env تغییر دهید

# ========================================
# DISCORD BOT TOKENS
# ========================================

# ربات مرکزی - ستاره داوود (ضروری)
MAGEN_DAVID_TOKEN=your_magen_david_bot_token_here

# ربات‌های دفاعی (اختیاری - برای عملکرد کامل توصیه می‌شود)
IRON_DOME_TOKEN=your_iron_dome_bot_token_here
DAVIDS_SLING_TOKEN=your_davids_sling_bot_token_here
ARROW_3_TOKEN=your_arrow_3_bot_token_here
ARROW_4_TOKEN=your_arrow_4_bot_token_here
THAAD_TOKEN=your_thaad_bot_token_here

# ربات‌های نظامی (اختیاری)
IDF_COMMAND_TOKEN=your_idf_command_bot_token_here
AIR_FORCE_TOKEN=your_air_force_bot_token_here
GROUND_FORCE_TOKEN=your_ground_force_bot_token_here
NAVY_TOKEN=your_navy_bot_token_here

# ربات‌های اطلاعاتی (اختیاری)
MOSSAD_TOKEN=your_mossad_bot_token_here
UNIT_8200_TOKEN=your_unit_8200_bot_token_here

# ربات‌های اقتصادی (اختیاری)
CENTRAL_BANK_TOKEN=your_central_bank_bot_token_here
MILITARY_INDUSTRIES_TOKEN=your_military_industries_bot_token_here

# ربات‌های مدنی (اختیاری)
ISRAEL_RADIO_TOKEN=your_israel_radio_bot_token_here
NATIONAL_NEWS_TOKEN=your_national_news_bot_token_here

# ========================================
# GOOGLE GEMINI AI API
# ========================================

# کلید API هوش مصنوعی جمنای (اختیاری اما توصیه می‌شود)
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# SERVER CONFIGURATION
# ========================================

# شناسه سرور دیسکورد (ضروری)
SERVER_ID=your_discord_server_id_here

# شناسه مالک سرور (ضروری)
OWNER_ID=your_discord_user_id_here

# ========================================
# DATABASE CONFIGURATION
# ========================================

# آدرس پایگاه داده (اختیاری - پیش‌فرض: SQLite)
DATABASE_URL=sqlite:///israel_rp.db

# ========================================
# LOGGING CONFIGURATION
# ========================================

# سطح لاگ (اختیاری - پیش‌فرض: INFO)
LOG_LEVEL=INFO

# فایل لاگ (اختیاری - پیش‌فرض: israel_rp.log)
LOG_FILE=israel_rp.log

# ========================================
# راهنمای تنظیم
# ========================================

# 1. این فایل را کپی کرده و نام آن را به .env تغییر دهید
# 2. توکن‌های ربات‌های دیسکورد را در قسمت مربوطه قرار دهید
# 3. کلید API جمنای را از https://ai.google.dev/ دریافت کنید
# 4. شناسه سرور و کاربر خود را قرار دهید
# 5. فایل .env را در .gitignore قرار دهید تا محرمانه بماند

# ========================================
# نحوه دریافت توکن‌ها
# ========================================

# Discord Bot Token:
# 1. به https://discord.com/developers/applications بروید
# 2. "New Application" کلیک کنید
# 3. نام ربات را وارد کنید
# 4. به بخش "Bot" بروید
# 5. "Add Bot" کلیک کنید
# 6. توکن را کپی کنید

# Google Gemini API Key:
# 1. به https://ai.google.dev/ بروید
# 2. "Get API key" کلیک کنید
# 3. پروژه جدید ایجاد کنید
# 4. کلید API را کپی کنید

# Discord Server ID:
# 1. Developer Mode را در Discord فعال کنید
# 2. روی سرور راست کلیک کنید
# 3. "Copy Server ID" کلیک کنید

# Discord User ID:
# 1. روی پروفایل خود راست کلیک کنید
# 2. "Copy User ID" کلیک کنید