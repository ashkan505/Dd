# ========================================
# توکن‌های ربات‌های اکوسیستم اسرائیل
# Israeli RP Bot Ecosystem Tokens
# ========================================

# ربات مرکزی - Central Bot
DISCORD_BOT_TOKEN_MAGEN_DAVID=YOUR_MAGEN_DAVID_BOT_TOKEN

# ربات‌های دفاعی - Defense Bots
DISCORD_BOT_TOKEN_IRON_DOME=YOUR_IRON_DOME_BOT_TOKEN
DISCORD_BOT_TOKEN_DAVID_SLING=YOUR_DAVID_SLING_BOT_TOKEN
DISCORD_BOT_TOKEN_ARROW_DEFENSE=YOUR_ARROW_DEFENSE_BOT_TOKEN
DISCORD_BOT_TOKEN_THAAD=YOUR_THAAD_BOT_TOKEN

# ربات‌های نظامی - Military Bots
DISCORD_BOT_TOKEN_ARMY_COMMAND=YOUR_ARMY_COMMAND_BOT_TOKEN
DISCORD_BOT_TOKEN_MOSSAD=YOUR_MOSSAD_BOT_TOKEN
DISCORD_BOT_TOKEN_UNIT_8200=YOUR_UNIT_8200_BOT_TOKEN

# ربات‌های اقتصادی - Economic Bots
DISCORD_BOT_TOKEN_CENTRAL_BANK=YOUR_CENTRAL_BANK_BOT_TOKEN
DISCORD_BOT_TOKEN_MILITARY_INDUSTRIES=YOUR_MILITARY_INDUSTRIES_BOT_TOKEN
DISCORD_BOT_TOKEN_STOCK_EXCHANGE=YOUR_STOCK_EXCHANGE_BOT_TOKEN

# ربات‌های مدنی - Civil Bots
DISCORD_BOT_TOKEN_JOBS_EDUCATION=YOUR_JOBS_EDUCATION_BOT_TOKEN
DISCORD_BOT_TOKEN_REAL_ESTATE=YOUR_REAL_ESTATE_BOT_TOKEN
DISCORD_BOT_TOKEN_POLITICAL_PARTIES=YOUR_POLITICAL_PARTIES_BOT_TOKEN
DISCORD_BOT_TOKEN_RADIO_ISRAEL=YOUR_RADIO_ISRAEL_BOT_TOKEN

# ربات‌های مدیریت بحران - Crisis Management Bots
DISCORD_BOT_TOKEN_CRISIS_MANAGEMENT=YOUR_CRISIS_MANAGEMENT_BOT_TOKEN
DISCORD_BOT_TOKEN_PERSONAL_PROGRESS=YOUR_PERSONAL_PROGRESS_BOT_TOKEN
DISCORD_BOT_TOKEN_UNDERGROUND=YOUR_UNDERGROUND_BOT_TOKEN

# ========================================
# کلیدهای API - API Keys
# ========================================

# کلید API گوگل جمنای (الزامی) - Google Gemini API Key (Required)
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY

# ========================================
# تنظیمات اختیاری - Optional Settings
# ========================================

# شناسه سرور دیسکورد - Discord Server ID
GUILD_ID=YOUR_DISCORD_SERVER_ID

# URL پایگاه داده - Database URL (for future use)
DATABASE_URL=sqlite:///israel_rp.db

# ========================================
# راهنمای تنظیم - Setup Guide
# ========================================

# 1. این فایل را به .env تغییر نام دهید
# 2. تمام مقادیر YOUR_* را با مقادیر واقعی جایگزین کنید
# 3. برای هر ربات یک Bot Application در Discord Developer Portal ایجاد کنید
# 4. کلید Gemini API را از Google AI Studio دریافت کنید
# 5. فایل .env را در .gitignore قرار دهید (امنیت)

# نکات مهم:
# - هرگز فایل .env را commit نکنید
# - توکن‌ها را محرمانه نگه دارید
# - هر ربات نیاز به توکن جداگانه دارد
# - Gemini API برای تولید محتوای هوشمند استفاده می‌شود